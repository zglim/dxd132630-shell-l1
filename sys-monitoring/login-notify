#!/bin/bash
##################################################
# Name: login-notify
# Description: Sends an email when user logs in to system.
# Script Maintainer: Jacob Amey
#
# Last Updated: July 9th 2013
##################################################
# Mail Configuration
#
SUBJECT="${SUBJECT:-Root Login Alert:$(hostname)}"
EMAIL="${EMAIL:-changeme@email.com}"
###################################################
# Logging Settings
#
Logging="${Logging:-true}"  #true/false
LOG_FILE="${LOG_FILE:-/var/log/login.log}"
###################################################
# Notification Variables
#
KNOWN_IPS="${KNOWN_IPS:-127.0.0.1}" # IPs you do not want to be notified about (space-separated).
WHO=$(w -si 2>/dev/null || echo "(unable to retrieve logged-in users)")

# Determine login IP — handle SSH, local, and su scenarios
if [ -n "$SSH_CLIENT" ]; then
    loginip=$(echo "$SSH_CLIENT" | awk '{print $1}')
elif [ -n "$SSH_CONNECTION" ]; then
    loginip=$(echo "$SSH_CONNECTION" | awk '{print $1}')
else
    loginip="local"
fi

authorized=false
###################################################
# is_known_ip — reliable whitelist check
#   Normalises the KNOWN_IPS list (trims spaces, deduplicates)
#   and does an exact match against the supplied IP.
#
is_known_ip() {
    local check_ip="$1"
    local ip
    # Build a deduplicated, trimmed list
    for ip in $KNOWN_IPS; do
        ip=$(echo "$ip" | tr -d '[:space:]')
        [ -z "$ip" ] && continue
        if [ "$check_ip" = "$ip" ]; then
            return 0
        fi
    done
    return 1
}

###################################################
# message Function — builds the alert body
#
message() {
    echo "${msgheader}$(hostname)"
    echo
    echo "------------: Login Info :---------------"
    echo
    echo "Login IP : $loginip"
    echo "Login User: $(whoami)"
    echo "Date-Time: $(date)"
    echo
    echo "------------: Logged in users :----------"
    echo
    echo "$WHO"
}
# End message Function
###################################################
# Determine authorization
#
if is_known_ip "$loginip"; then
    authorized=true
    msgheader="Authorized Login to Server: "
else
    msgheader="Unauthorized Login to Server: "
fi

# Capture message content once for reuse
msg_body=$(message)

###################################################
# Send email for unauthorized logins
#
if [ "$authorized" != "true" ]; then
    if command -v mail >/dev/null 2>&1; then
        echo "$msg_body" | mail -s "$SUBJECT" "$EMAIL" 2>/dev/null || true
    fi
fi

###################################################
# Logging statement
#
if [ "$Logging" = "true" ]; then
    log_dir=$(dirname "$LOG_FILE")
    if [ -d "$log_dir" ] && [ -w "$log_dir" ] || [ -w "$LOG_FILE" ]; then
        echo "$msg_body" >> "$LOG_FILE" 2>/dev/null || true
    fi
fi
# EOF
